# Build output. Generated by build.ps1 from src\, and published from there -
# committing it invites a repo where the artefact and the source disagree.
/trim.ps1
/trim.ps1.sha256

# Staged copy for deployment. Regenerated by hosting\Publish-Trim.ps1 on every
# publish, from a fresh build.
/hosting/public/

# Test output copied out of the sandbox.
/test/results/

# Generated by test\Invoke-SandboxTest.ps1 from wherever the repo is checked
# out. A .wsb cannot express a relative path, so a committed one is pinned to
# one machine's directory layout and will not launch on any other.
/test/sandbox.wsb

# Generated by test\Export-Coverage.ps1 from a real dry run, so it describes the
# hardware, drive letters and installed games of whoever generated it. Useful
# locally; not something to publish.
/docs/COVERAGE.md

# Wrangler
/hosting/.wrangler/
node_modules/

# Local scratch
*.log
*.tmp
